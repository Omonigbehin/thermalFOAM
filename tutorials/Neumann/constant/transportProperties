FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// NEUMANN BENCHMARK — pure water / ice, no soil matrix
//
// Material:  theta = 1.0 (fully saturated pore space)
//            thetas = 1.0 (100 % porosity, phi_solid = 0)
//
// With phi_solid = 0 the Johansen model collapses to:
//   K_eff = K_water^f_l * K_ice^(1-f_l)       (geometric mean, two-phase)
//   C_sens = f_l * Cthw + (1-f_l) * Cthice     (volume-weighted)
//
// SFCC: linear, sharp interface
//   T_solidus  = 272.95 K   ← onset of melting (−0.20 °C)
//   T_liquidus = 273.15 K   ← fully liquid     (  0.00 °C)
//   dT_mushy   = 0.20 K     → CthEff_peak ≈ L/dT = 334e6/0.2 = 1.67e9 J/(m³·K)
//
// These settings give a mushy zone ≈ 2–3 mm wide at the interface,
// which is invisible at the plot scale and produces < 0.02 K deviation
// from the sharp-interface Neumann solution everywhere else.

// -----------------------------------------------------------------------
// SOIL SKELETON (absent — set phi_solid = 0 via thetas = 1)
// -----------------------------------------------------------------------
thetas      thetas      [0 0 0 0 0 0 0]     1.0;    // all pore space, no solid
theta_org   theta_org   [0 0 0 0 0 0 0]     0.0;
Cthorg      Cthorg      [1 -1 -2 -1 0 0 0]  2.5e6;  // unused (theta_org = 0)

// -----------------------------------------------------------------------
// THERMAL CONDUCTIVITY  [W/(m·K)]
// -----------------------------------------------------------------------
// Pure water/ice values; Kthsoil and Kthair are unused (phi_solid = phi_air = 0)
Kthw        [1 1 -3 -1 0 0 0]   0.62;       // liquid water
Kthice      [1 1 -3 -1 0 0 0]   2.22;       // ice
Kthsoil     [1 1 -3 -1 0 0 0]   2.22;       // placeholder (phi_solid = 0)
Kthair      [1 1 -3 -1 0 0 0]   0.58;       // placeholder (phi_air   = 0)

// -----------------------------------------------------------------------
// VOLUMETRIC HEAT CAPACITIES  [J/(m³·K)]
// -----------------------------------------------------------------------
Cthsoil     Cthsoil     [1 -1 -2 -1 0 0 0]  1.92e6; // placeholder
Cthw        Cthw        [1 -1 -2 -1 0 0 0]  4.186e6; // liquid water
Cthice      Cthice      [1 -1 -2 -1 0 0 0]  1.920e6; // ice
Cthair      Cthair      [1 -1 -2 -1 0 0 0]  1.92e6;  // placeholder

// -----------------------------------------------------------------------
// LATENT HEAT AND MELTING TEMPERATURE
// -----------------------------------------------------------------------
L           L           [1 -1 -2 0 0 0 0]   334e6;  // J/m³  (volumetric)
Tmelt       Tmelt       [0 0 0 1 0 0 0]     273.15; // K

// Temperature clamp (prevents unphysical values at iteration start)
Tminc       Tminc       [0 0 0 1 0 0 0]     253.15; // −20 °C
Tmaxc       Tmaxc       [0 0 0 1 0 0 0]     293.15; // +20 °C

// -----------------------------------------------------------------------
// SFCC — Gaussian model (from Test7 tutorial)
// -----------------------------------------------------------------------
SFCCModel       gaussian;

// Solidus / liquidus (used by the linear SFCC model)
T_solidus       272.95;   // K  (−0.20 °C)
T_liquidus      273.15;   // K  ( 0.00 °C)

// Power-law parameters (unused for gaussian model, required fields)
SFCC_Tref       SFCC_Tref   [0 0 0 1 0 0 0]    1.0;
SFCC_b          SFCC_b      [0 0 0 0 0 0 0]     3.0;

// Gaussian freezing curve width [K]
SFCC_W          0.1;

// No residual unfrozen water for pure ice benchmark
thetar_frac     0.0;

// -----------------------------------------------------------------------
// SOLVER MODE
// -----------------------------------------------------------------------
// Selects the apparent heat-capacity Picard-lagged solve (production/validated path)
useEnthalpyPorosity     true;

// Minimum CthEff floor (keep small to avoid polluting mushy zone physics)
minCthEff   1e4;

// maxCthEff is read by thermalFoam.C for Fourier guidance; does not cap CthEff
maxCthEff   2e9;

// -----------------------------------------------------------------------
// EROSION (disabled for validation benchmark)
// -----------------------------------------------------------------------
erosionControls
{
    enableErosion   false;
}

